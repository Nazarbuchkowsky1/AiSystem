{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "string"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost": {
      "type": "number",
      "default": 0,
      "description": "API cost in USD for generating this response"
    },
    "citations": {
      "type": "string",
      "description": "JSON-serialized array of citation sources used in the response"
    },
    "activity": {
      "type": "string",
      "description": "JSON-serialized activity timeline for the response (steps, durations)"
    }
  },
  "required": [
    "conversation_id",
    "role",
    "content"
  ]
}